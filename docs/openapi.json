  "components": {
    "schemas": {
      "ControlInput": {
        "properties": {
          "actor": {
            "type": "string",
            "minLength": 1,
            "title": "Actor"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "actor",
          "reason"
        ],
        "title": "ControlInput"
      },
      "CvePayload": {
        "properties": {
          "repo": {
            "type": "string",
            "title": "Repo"
          },
          "code_version": {
            "type": "string",
            "title": "Code Version"
          },
          "package": {
            "type": "string",
            "minLength": 1,
            "title": "Package"
          },
          "current_version": {
            "type": "string",
            "minLength": 1,
            "title": "Current Version"
          },
          "affected_introduced": {
            "type": "string",
            "title": "Affected Introduced",
            "default": "0.0.0"
          },
          "fixed_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fixed Version"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity",
            "default": "HIGH"
          },
          "actor": {
            "type": "string",
            "title": "Actor",
            "default": "cve-subscription"
          }
        },
        "type": "object",
        "required": [
          "repo",
          "code_version",
          "package",
          "current_version"
        ],
        "title": "CvePayload"
      },
      "DefectClass": {
        "type": "string",
        "enum": [
          "C01",
          "C02",
          "C03",
          "C05"
        ],
        "title": "DefectClass"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ManualIssueInput": {
        "properties": {
          "repo": {
            "type": "string",
            "minLength": 1,
            "title": "Repo"
          },
          "code_version": {
            "type": "string",
            "minLength": 1,
            "title": "Code Version"
          },
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "title": "Rule Id"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "title": "File"
          },
          "line": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          },
          "component": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Component"
          },
          "component_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Component Version"
          },
          "defect_class": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DefectClass"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_kind": {
            "$ref": "#/components/schemas/SourceKind",
            "default": "MANUAL"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "repo",
          "code_version",
          "rule_id",
          "severity",
          "file"
        ],
        "title": "ManualIssueInput"
      },
      "RepoWebhookPayload": {
        "properties": {
          "repo": {
            "type": "string",
            "minLength": 1,
            "title": "Repo"
          },
          "branch": {
            "type": "string",
            "minLength": 1,
            "title": "Branch"
          },
          "base_sha": {
            "type": "string",
            "minLength": 1,
            "title": "Base Sha"
          },
          "action": {
            "type": "string",
            "title": "Action",
            "default": "merged"
          },
          "actor": {
            "type": "string",
            "title": "Actor",
            "default": "codearts-repo"
          }
        },
        "type": "object",
        "required": [
          "repo",
          "branch",
          "base_sha"
        ],
        "title": "RepoWebhookPayload"
      },
      "ReviewInput": {
        "properties": {
          "actor": {
            "type": "string",
            "minLength": 1,
            "title": "Actor"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "title": "Reason"
          },
          "conclusion": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VerdictConclusion"
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "actor",
          "reason"
        ],
        "title": "ReviewInput"
      },
      "RuntimeAlertPayload": {
        "properties": {
          "repo": {
            "type": "string",
            "title": "Repo"
          },
          "code_version": {
            "type": "string",
            "title": "Code Version"
          },
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "title": "Rule Id"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "title": "File"
          },
          "line": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity",
            "default": "HIGH"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet",
            "default": ""
          },
          "evidence_ref": {
            "type": "string",
            "title": "Evidence Ref",
            "default": ""
          },
          "actor": {
            "type": "string",
            "title": "Actor",
            "default": "runtime-agent"
          }
        },
        "type": "object",
        "required": [
          "repo",
          "code_version",
          "rule_id",
          "file"
        ],
        "title": "RuntimeAlertPayload"
      },
      "ScheduleTriggerInput": {
        "properties": {
          "repo": {
            "type": "string",
            "minLength": 1,
            "title": "Repo"
          },
          "window": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}$",
            "title": "Window"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "title": "Idempotency Key"
          },
          "base_sha": {
            "type": "string",
            "title": "Base Sha",
            "default": "HEAD"
          }
        },
        "type": "object",
        "required": [
          "repo",
          "window",
          "idempotency_key"
        ],
        "title": "ScheduleTriggerInput"
      },
      "Severity": {
        "type": "string",
        "enum": [
          "CRITICAL",
          "HIGH",
          "MEDIUM",
          "LOW",
          "INFO"
        ],
        "title": "Severity"
      },
      "SourceKind": {
        "type": "string",
        "enum": [
          "CHECK",
          "GOVERNANCE",
          "OSV",
          "CNVD",
          "RUNTIME_ALERT",
          "MANUAL"
        ],
        "title": "SourceKind"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerdictConclusion": {
        "type": "string",
        "enum": [
          "REACHABLE",
          "UNREACHABLE",
          "SUSPECTED"
        ],
        "title": "VerdictConclusion"
      }
    }
  }
}