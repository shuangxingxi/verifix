FROM python:3.12-slim

COPY requirements.target.txt /tmp/requirements.target.txt
RUN pip install --no-cache-dir -r /tmp/requirements.target.txt && rm -f /tmp/requirements.target.txt

RUN useradd --uid 10001 --create-home app \
    && mkdir -p /target \
    && chown -R 10001:10001 /target /home/app

WORKDIR /target
USER 10001:10001
ENTRYPOINT ["python"]