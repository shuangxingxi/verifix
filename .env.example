# VeriFix 环境变量样例（复制为 .env 后填写；禁止提交真实凭据）
# deploy/.env.example 为容器部署专用样例，两者字段保持一致。

# 服务与证据
VERIFIX_WEBHOOK_SECRET=change-me
VERIFIX_EVIDENCE_ROOT=.evidence

# 分支与发布（冻结项，变更需写事件留痕）
VERIFIX_BRANCH_NAMESPACE=verifix
VERIFIX_RELEASE_AUTO_BRANCH=release/auto

# 运行与阶段时限（秒）
VERIFIX_RUN_DEADLINE_SECONDS=900
VERIFIX_RUN_MAX_CONCURRENCY=3
VERIFIX_STAGE_TRIAGE_SECONDS=90
VERIFIX_STAGE_REPRODUCE_SECONDS=240
VERIFIX_STAGE_PATCH_SECONDS=180
VERIFIX_STAGE_AUDIT_SECONDS=120
VERIFIX_STAGE_GATE_READBACK_SECONDS=600

# 沙箱（运行期禁网不可配置）
VERIFIX_SANDBOX_CPU=1.0
VERIFIX_SANDBOX_MEM=1024
VERIFIX_SANDBOX_SECONDS=60

# 补丁与熔断（冻结项）
VERIFIX_PATCH_MAX_LINES=30
VERIFIX_PATCH_MAX_FILES=3
VERIFIX_PATCH_STRENGTH_L0_L1_MIN=0.60
VERIFIX_SUSPICION_THRESHOLD=0.60
VERIFIX_CIRCUIT_FAIL_STREAK=3
VERIFIX_BLACKLIST_TTL_HOURS=168

# 模型 Provider（T5 可替换；不改变编排与提示词结构）
VERIFIX_MODEL_PROVIDER=local
VERIFIX_MODEL_MAX_CALLS_PER_ISSUE=3
VERIFIX_MODEL_CALL_TIMEOUT_SECONDS=60

# CodeArts 接入（未配置时相关能力为 not_configured，不得声称已验证）
VERIFIX_CHECK_RULESET=
VERIFIX_GATE_PIPELINE_ID=
VERIFIX_CODEARTS_HOST=

# 依赖连通性（/readyz 探测；空值记为 not_configured）
VERIFIX_RDS_HOST=
VERIFIX_RDS_PORT=3306
VERIFIX_REDIS_HOST=
VERIFIX_REDIS_PORT=6379
VERIFIX_OBS_ENDPOINT=
VERIFIX_MAAS_HOST=
